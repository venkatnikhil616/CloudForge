FROM python:3.11-slim as builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential gcc && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim as runner

WORKDIR /app
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app

# Create non-root user
RUN groupadd -r cloudtask && useradd -r -g cloudtask cloudtask

COPY pkg/ /app/pkg/
COPY database/ /app/database/
COPY services/ /app/services/
COPY scripts/ /app/scripts/

RUN chown -R cloudtask:cloudtask /app
USER cloudtask

ENV PORT=8000
EXPOSE $PORT

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request, os; urllib.request.urlopen(f'http://localhost:{os.getenv(\"PORT\", 8000)}/health/live')" || exit 1

CMD ["/bin/bash", "/app/scripts/start_render.sh"]
