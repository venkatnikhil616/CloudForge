# Global Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=cloudtask
POSTGRES_PASSWORD=cloudtask_secret
POSTGRES_DB=cloudtask_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudtask:cloudtask_secret@localhost:5432/cloudtask_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=cloudtask.events
RABBITMQ_TASK_QUEUE=cloudtask.tasks
RABBITMQ_DLQ_QUEUE=cloudtask.tasks.dlq
RABBITMQ_NOTIFICATION_QUEUE=cloudtask.notifications

# Security & JWT Configuration
JWT_SECRET_KEY=super-secret-production-grade-encryption-key-change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service Port Configuration
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
TASK_SERVICE_PORT=8002
NOTIFICATION_SERVICE_PORT=8003
METRICS_PORT=9090

# Worker Settings
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=4
WORKER_INITIAL_BACKOFF_SECONDS=5
